            },
            "description": ""
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {}
        ],
        "summary": "Album page by local id",
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/v1/albums/{album_id}/rating": {
