          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "properties": {
          "identifier": {
            "examples": [
              "ann_listens"
            ],
            "maxLength": 254,
            "minLength": 1,
            "title": "Identifier",
            "type": "string"
          },
          "password": {
            "examples": [
              "Secret123"
            ],
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "identifier",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "ModerationLogEntryOut": {
        "properties": {
          "account_id": {
            "format": "uuid",
            "title": "Account Id",
            "type": "string"
          },
          "account_username": {
            "title": "Account Username",
            "type": "string"
          },
          "action": {
            "title": "Action",
            "type": "string"
          },
          "admin_id": {
            "format": "uuid",
            "title": "Admin Id",
            "type": "string"
          },
          "admin_username": {
            "title": "Admin Username",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "required": [
          "id",
          "admin_id",
          "admin_username",
          "account_id",
          "account_username",
          "action",
          "reason",
          "created_at"
        ],
        "title": "ModerationLogEntryOut",
        "type": "object"
      },
      "ModerationLogPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ModerationLogEntryOut"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "ModerationLogPage",
        "type": "object"
      },
      "PasswordChangeRequest": {
        "additionalProperties": false,
        "properties": {
          "current_password": {
            "examples": [
              "Secret123"
            ],
            "maxLength": 128,
            "minLength": 1,
            "title": "Current Password",
            "type": "string"
          },
          "new_password": {
            "examples": [
              "Better456"
            ],
            "title": "New Password",
            "type": "string"
          }
        },
        "required": [
          "current_password",
          "new_password"
        ],
        "title": "PasswordChangeRequest",
        "type": "object"
      },
      "ProfilePatch": {
        "additionalProperties": false,
        "properties": {
          "bio": {
            "anyOf": [
              {
                "maxLength": 300,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "Shoegaze and jazz."
            ],
            "title": "Bio"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "Ann B."
            ],
            "title": "Display Name"
          }
        },
        "title": "ProfilePatch",
        "type": "object"
      },
      "RegisterRequest": {
        "additionalProperties": false,
        "properties": {
          "display_name": {
            "examples": [
              "Ann"
            ],
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "examples": [
              "ann@example.com"
            ],
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "examples": [
              "Secret123"
            ],
            "title": "Password",
            "type": "string"
          },
          "username": {
            "examples": [
              "ann_listens"
            ],
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "email",
          "display_name",
          "password"
        ],
        "title": "RegisterRequest",
        "type": "object"
      },
      "TokenResponse": {
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "title": "Expires In",
            "type": "integer"
          },
          "token_type": {
            "default": "Bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "expires_in"
        ],
        "title": "TokenResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
