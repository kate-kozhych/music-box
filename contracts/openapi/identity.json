        ],
        "title": "AvatarOut",
        "type": "object"
      },
      "BlockRequest": {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "title": "BlockRequest",
        "type": "object"
      },
      "Body_put_avatar_api_v1_account_avatar_put": {
