# =============================================================================
# Innotter 2.0 — environment configuration
#
#   cp .env.example .env
#
# Every variable the code reads must be listed here with a comment (NFR-006).
# Prefixes: IDENTITY_ (Identity), CORE_ (Innotter Core), NOTIF_ (Notification),
# GW_ (gateway). Values below are LOCAL DEMO defaults only — change every
# "change-me" value before exposing the stack to anyone else (NFR-036).
# JWT signing keys are NOT configured here: Identity generates an Ed25519 key
# pair into its private volume on first start (ADR-0005).
#
# Read by: identity/settings.py, innotter_core/config/env.py, notifier/settings.py
# and compose.yaml. Compose fills the container-specific ones (hosts, dirs).
# =============================================================================

# --- Compose -----------------------------------------------------------------
# Project name; prefixes container, network and volume names.
COMPOSE_PROJECT_NAME=innotter

# --- Gateway (Nginx) ---------------------------------------------------------
# The only host port published by the default profile (NFR-007).
GW_HTTP_PORT=8080

# --- Identity Service (FastAPI + PostgreSQL 17) -------------------------------
# Runtime environment: prod | dev | test. Debug output only in dev.
IDENTITY_ENV=prod
# PostgreSQL connection parts (also used to initialise the postgres container).
IDENTITY_DB_HOST=postgres
IDENTITY_DB_PORT=5432
IDENTITY_DB_NAME=identity
IDENTITY_DB_USER=identity
IDENTITY_DB_PASSWORD=change-me-identity-db
# Redis URLs: db0 = auth state (written by Identity), db3 = login throttle.
IDENTITY_REDIS_AUTH_URL=redis://redis:6379/0
IDENTITY_REDIS_THROTTLE_URL=redis://redis:6379/3
# RabbitMQ connection used by the outbox relay.
IDENTITY_AMQP_URL=amqp://innotter:change-me-rabbit@rabbitmq:5672/
# JWT claims (ADR-0005). Access token lifetime in seconds (15 min).
IDENTITY_JWT_ISSUER=innotter-identity
IDENTITY_JWT_AUDIENCE=innotter
IDENTITY_ACCESS_TOKEN_TTL_SECONDS=900
# Opaque refresh token lifetime in days (7 days).
IDENTITY_REFRESH_TOKEN_TTL_DAYS=7
# Directory (volume) where the Ed25519 signing keys are generated and kept.
IDENTITY_KEYS_DIR=/var/lib/identity/keys
# Directory (volume) for uploaded avatars; served read-only by the gateway.
IDENTITY_AVATAR_DIR=/var/lib/identity/avatars
# Mark the refresh cookie Secure. Keep false for the plain-HTTP localhost demo.
IDENTITY_COOKIE_SECURE=false
# Publish outbox events to RabbitMQ from the API process (false only in tests).
IDENTITY_OUTBOX_RELAY_ENABLED=true
# Brute-force protection (NFR-038): failures per identifier+IP per window, registrations per IP per hour.
IDENTITY_LOGIN_MAX_FAILURES=5
IDENTITY_LOGIN_WINDOW_SECONDS=900
IDENTITY_REGISTER_MAX_PER_HOUR=10
# Argon2id cost parameters (defaults follow RFC 9106 "low memory"; tests lower them).
IDENTITY_ARGON2_TIME_COST=3
IDENTITY_ARGON2_MEMORY_COST_KIB=65536
IDENTITY_ARGON2_PARALLELISM=4
# Log level for JSON logs: DEBUG | INFO | WARNING | ERROR.
IDENTITY_LOG_LEVEL=INFO
# Admin bootstrap (US-040): `python -m identity.cli bootstrap-admin`, run by the seed job.
IDENTITY_ADMIN_USERNAME=admin
IDENTITY_ADMIN_EMAIL=admin@example.com
IDENTITY_ADMIN_PASSWORD=change-me-Admin-Passw0rd

# --- Innotter Core (Django + DRF + Celery + MySQL 8.4) ------------------------
# Runtime environment: prod | dev | test.
CORE_ENV=prod
# Django secret key (signing of Django internals only, not JWTs). >= 50 chars.
CORE_SECRET_KEY=change-me-core-secret-key-at-least-fifty-characters-long-0000
# Comma-separated host names Django accepts (127.0.0.1 is always added for health checks).
CORE_ALLOWED_HOSTS=localhost,core-api
# Log level for JSON logs.
CORE_LOG_LEVEL=INFO
# MySQL connection parts (also used to initialise the mysql container).
CORE_DB_HOST=mysql
CORE_DB_PORT=3306
CORE_DB_NAME=innotter_core
CORE_DB_USER=innotter_core
CORE_DB_PASSWORD=change-me-core-db
# MySQL root password (container initialisation only; never used by the app).
CORE_DB_ROOT_PASSWORD=change-me-mysql-root
# Redis URLs: db0 = auth state (read only), db1 = Celery broker/results, db2 = cache + MusicBrainz limiter.
CORE_REDIS_AUTH_URL=redis://redis:6379/0
CORE_CELERY_BROKER_URL=redis://redis:6379/1
CORE_REDIS_CACHE_URL=redis://redis:6379/2
# RabbitMQ connection (outbox relay + identity-events consumer).
CORE_AMQP_URL=amqp://innotter:change-me-rabbit@rabbitmq:5672/
# Internal JWKS endpoint of Identity (not exposed by the gateway).
CORE_JWKS_URL=http://identity:8000/.well-known/jwks.json
# Music catalog mode: offline (fixtures only, no outbound calls — default) | live (MusicBrainz).
CORE_CATALOG_MODE=offline
# Contact for the MusicBrainz User-Agent. REQUIRED when CORE_CATALOG_MODE=live (NFR-061).
CORE_MB_USER_AGENT_CONTACT=
# Days after which a stored album is lazily refreshed from MusicBrainz (FR-020).
CORE_MB_TTL_DAYS=30

# --- Notification Service (FastAPI + MongoDB 8) ------------------------------
# Runtime environment: prod | dev | test.
NOTIF_ENV=prod
# MongoDB connection (single node, no replica set).
NOTIF_MONGO_URL=mongodb://notif:change-me-mongo@mongo:27017/?authSource=admin
NOTIF_MONGO_DB=notifications
# MongoDB root credentials (container initialisation).
NOTIF_MONGO_ROOT_USER=notif
NOTIF_MONGO_ROOT_PASSWORD=change-me-mongo
# Redis auth state (read only).
NOTIF_REDIS_AUTH_URL=redis://redis:6379/0
# RabbitMQ connection for the consumer.
NOTIF_AMQP_URL=amqp://innotter:change-me-rabbit@rabbitmq:5672/
# Internal JWKS endpoint of Identity.
NOTIF_JWKS_URL=http://identity:8000/.well-known/jwks.json
# Log level for JSON logs.
NOTIF_LOG_LEVEL=INFO

# --- Shared infrastructure ----------------------------------------------------
# Message broker default user (RabbitMQ container initialisation; must match the
# *_AMQP_URL values above). Named BROKER_* on purpose (implementation-plan §6.2).
BROKER_USER=innotter
BROKER_PASSWORD=change-me-rabbit
